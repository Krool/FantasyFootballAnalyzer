# Yahoo API URL (defaults to your Vercel deployment)
VITE_YAHOO_API_URL=https://your-app.vercel.app

# Dev-only crocodile button on the home page (src/pages/HomePage.tsx): one
# click loads a test league. Put real values in .env.local (gitignored);
# the ESPN cookies are your whole ESPN session, so never commit them.
VITE_DEV_SLEEPER_LEAGUE_ID=
VITE_DEV_ESPN_LEAGUE_ID=
VITE_DEV_ESPN_SEASON=2025
VITE_DEV_ESPN_S2=
VITE_DEV_ESPN_SWID=
